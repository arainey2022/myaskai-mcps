{
  "name": "myaskai-mcps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public My AskAI Model Context Protocol servers on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:upstream": "tsx scripts/check-upstream-contract.ts",
    "smoke": "tsx scripts/smoke-mcp.ts",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run --strict",
    "check:production": "npm run typecheck && npm test && wrangler deploy --config wrangler.production.jsonc --dry-run --strict",
    "deploy:development": "wrangler deploy",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260817.1",
    "@types/node": "^26.2.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=22"
  }
}
