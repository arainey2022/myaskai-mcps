{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myaskai-mcps",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mcp.myaskai.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "MCP_USAGE",
      "dataset": "myaskai_mcp_usage"
    }
  ],
  "vars": {
    "DOCS_MCP_UPSTREAM": "https://myaskai.mintlify.app/mcp",
    "UPSTREAM_TIMEOUT_MS": "15000"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "26081701",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
